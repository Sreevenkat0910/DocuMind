# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#   cp .env.example .env
#
# Format is plain KEY=value (no quotes, no `export`).

# Groq API key (used for CHAT). Get one at https://console.groq.com/keys
GROQ_API_KEY=

# JWT signing secret (Phase 2 auth). Must be at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Shared secret between the Java app and the Python gateway (Phase 3). Sent as the
# X-Internal-Api-Key header on every internal call. Generate one with:
#   openssl rand -base64 32
INTERNAL_API_KEY=
